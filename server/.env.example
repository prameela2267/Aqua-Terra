# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (Leave blank to automatically use embedded MongoMemoryServer for instant zero-config evaluation)
MONGODB_URI=

# JWT Secret & Expiry
JWT_SECRET=smart_irrigation_jwt_super_secret_production_key_2026
JWT_EXPIRES_IN=7d

# OpenWeatherMap API Key (Optional: system provides seamless realistic fallback if left blank or quota exceeded)
OPENWEATHER_API_KEY=

# Default Region / City
DEFAULT_CITY=Bengaluru
