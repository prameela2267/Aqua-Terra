# -------------------------------------------------------------
# Smart Irrigation System — Root Environment Configurations
# -------------------------------------------------------------

# Backend Server Port
PORT=5000
NODE_ENV=development

# MongoDB URI (Optional: Leave empty for zero-setup embedded MongoMemoryServer)
MONGODB_URI=

# JWT Secret Key
JWT_SECRET=smart_irrigation_jwt_super_secret_production_key_2026
JWT_EXPIRES_IN=7d

# OpenWeatherMap API Key (Optional: system provides dynamic fallback if omitted)
OPENWEATHER_API_KEY=

# Default Region / City for Weather Forecasts
DEFAULT_CITY=Bengaluru

# Frontend Vite API URL (Optional in dev, handled via Vite proxy)
VITE_API_URL=http://localhost:5000/api
